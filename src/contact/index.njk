---
layout: base.njk
permalink: "/contact/"
current: "contact"
appeal: true
css: ["pages/contact"]
js: []
eleventyComputed:
  title: "{{ text.contact.meta.title }}"
  description: "{{ text.contact.meta.description }}"
---
<main id="main">
<!-- Intro -->
<section aria-labelledby="pg-h" style="background:#E8EEF7">
<div class="wrap" style="padding-top:72px; padding-bottom:72px">
<div class="head-grid">
<h1 id="pg-h" class="display" style="color:#1F3158">{{ text.contact.s1.h1 | rich({hl: 'color:#ED217C' }) | safe }}</h1>
<div style="display:flex; flex-direction:column; gap:14px; max-width:460px"><p class="lede" style="">{{ text.contact.s1.p }}</p><p style="margin:0; font-size:15px; line-height:1.7; color:#4F596B; ">{{ text.contact.s1.p2 }}</p></div>
</div>
</div>
</section>

<section class="sec" style="background:#ffffff; padding-top:80px"><div class="wrap"><div class="two-f">
<div><form method="post" name="contact" data-form="contact" data-netlify="true" data-netlify-honeypot="bot-field" style="display:flex; flex-direction:column; gap:20px"><input type="hidden" name="form-name" value="contact"><p hidden><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
<div class="f2">
<div style="display:flex; flex-direction:column; gap:8px; min-width:0"><label for="c-first" style="font-size:15px; font-weight:500; color:#333333">{{ text.contact.s2.label }} <span aria-hidden="true">*</span></label><div class="field" style="display:flex; align-items:center; padding:0 16px; min-height:54px"><input id="c-first" name="first" type="text" placeholder="" value="" autocomplete="given-name" required style="flex:1; min-width:0; min-height:48px; border:0; outline:none; background:transparent; font-family:Montserrat,system-ui,sans-serif; font-size:16px; font-weight:500; color:#333333"></div></div>
<div style="display:flex; flex-direction:column; gap:8px; min-width:0"><label for="c-last" style="font-size:15px; font-weight:500; color:#333333">{{ text.contact.s2.label2 }} <span aria-hidden="true">*</span></label><div class="field" style="display:flex; align-items:center; padding:0 16px; min-height:54px"><input id="c-last" name="last" type="text" placeholder="" value="" autocomplete="family-name" required style="flex:1; min-width:0; min-height:48px; border:0; outline:none; background:transparent; font-family:Montserrat,system-ui,sans-serif; font-size:16px; font-weight:500; color:#333333"></div></div>
</div>
<div class="f2">
<div style="display:flex; flex-direction:column; gap:8px; min-width:0"><label for="c-email" style="font-size:15px; font-weight:500; color:#333333">{{ text.contact.s2.label3 }} <span aria-hidden="true">*</span></label><div class="field" style="display:flex; align-items:center; padding:0 16px; min-height:54px"><input id="c-email" name="email" type="email" placeholder="" value="" autocomplete="email" required style="flex:1; min-width:0; min-height:48px; border:0; outline:none; background:transparent; font-family:Montserrat,system-ui,sans-serif; font-size:16px; font-weight:500; color:#333333"></div></div>
<div style="display:flex; flex-direction:column; gap:8px; min-width:0"><label for="c-phone" style="font-size:15px; font-weight:500; color:#333333">{{ text.contact.s2.label4 }}</label><div class="field" style="display:flex; align-items:center; padding:0 16px; min-height:54px"><input id="c-phone" name="phone" type="tel" placeholder="" value="" autocomplete="tel" style="flex:1; min-width:0; min-height:48px; border:0; outline:none; background:transparent; font-family:Montserrat,system-ui,sans-serif; font-size:16px; font-weight:500; color:#333333"></div></div>
</div>
<div style="display:flex; flex-direction:column; gap:8px; min-width:0"><label for="c-topic" style="font-size:15px; font-weight:500; color:#333333">{{ text.contact.s2.label5 }} <span aria-hidden="true">*</span></label><div class="field" style="position:relative; display:flex; align-items:center; padding:0 16px; min-height:54px"><select id="c-topic" name="topic" style="flex:1; min-width:0; min-height:48px; border:0; outline:none; background:transparent; appearance:none; -webkit-appearance:none; font-family:Montserrat,system-ui,sans-serif; font-size:16px; font-weight:500; color:#333333; padding-right:32px"><option value="" selected disabled>{{ text.contact.s2.option }}</option><option>{{ text.contact.s2.option2 }}</option><option>{{ text.contact.s2.option3 }}</option><option>{{ text.contact.s2.option4 }}</option><option>{{ text.contact.s2.option5 }}</option></select><span style="position:absolute; right:16px; pointer-events:none; color:#1F3158; display:flex"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M6 9l6 6 6-6"/></svg></span></div></div>
<div style="display:flex; flex-direction:column; gap:8px; min-width:0"><label for="c-cat" style="font-size:15px; font-weight:500; color:#333333">{{ text.contact.s2.label6 }}</label><div class="field" style="display:flex; align-items:center; padding:0 16px; min-height:54px"><input id="c-cat" name="cat" type="text" placeholder="" value="" style="flex:1; min-width:0; min-height:48px; border:0; outline:none; background:transparent; font-family:Montserrat,system-ui,sans-serif; font-size:16px; font-weight:500; color:#333333"></div><span style="font-size:13px; line-height:1.5; color:#4F596B">{{ text.contact.s2.text }}</span></div>
<div style="display:flex; flex-direction:column; gap:8px; min-width:0"><label for="c-msg" style="font-size:15px; font-weight:500; color:#333333">{{ text.contact.s2.label7 }} <span aria-hidden="true">*</span></label><div class="field" style="padding:12px 16px"><textarea id="c-msg" name="msg" placeholder="" required style="display:block; width:100%; min-height:170px; border:0; outline:none; resize:vertical; background:transparent; font-family:Montserrat,system-ui,sans-serif; font-size:16px; line-height:1.6; font-weight:500; color:#333333"></textarea></div></div>
<label for="c-news" style="display:flex; gap:14px; align-items:flex-start; min-height:44px; padding:6px 0; font-size:15px; line-height:1.55; color:#333333; cursor:pointer"><input id="c-news" name="newsletter" type="checkbox" style="flex:none; width:22px; height:22px; margin:1px 0 0; accent-color:#1F3158"><span>{{ text.contact.s2.text2 }}</span></label>
<div style="display:flex; flex-direction:column; gap:14px; align-items:flex-start">
<button class="btn btn-primary" type="submit" style="min-height:56px">{{ text.contact.s2.button }}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
<p style="margin:0; font-size:13px; line-height:1.6; color:#4F596B; max-width:520px">{{ text.contact.s2.p | rich({a: {'class': 'link-u', 'style': 'color:#1F3158; font-weight:500' } }) | safe }}</p>
</div>
</form></div>
<div style="display:flex; flex-direction:column; gap:36px">
<dl class="dl-rules">
<div class="fact"><dt>{{ text.contact.s2.dt }}</dt><dd><a class="link-u" href="mailto:info@happypawscatrescue.org" style="color:#1F3158">{{ text.contact.s2.link }}</a></dd></div>
<div class="fact"><dt>{{ text.contact.s2.dt2 }}</dt><dd>{{ text.contact.s2.dd }}</dd></div>
<div class="fact"><dt>{{ text.contact.s2.dt3 }}</dt><dd>{{ text.contact.s2.dd2 }}</dd></div>
<div class="fact"><dt>{{ text.contact.s2.dt4 }}</dt><dd>{{ text.contact.s2.dd3 }}</dd></div>
<div class="fact"><dt>{{ text.contact.s2.dt5 }}</dt><dd>{{ text.contact.s2.dd4 | rich | safe }}</dd></div>
</dl>
<figure class="ph " style="aspect-ratio:4/3; background:#EAD3C9; "><img fetchpriority="high" decoding="async" src="{{ text.contact.s2.img }}" alt="{{ text.contact.s2.alt }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:50% 40%; display:block"></figure>
</div>
</div></div></section>

<section aria-labelledby="faq-h" class="sec" style="background:#E8EEF7; "><div class="wrap"><div class="two-grid">
<h2 id="faq-h" class="h2" style="color:#ED217C">{{ text.contact.s3.h2 | rich | safe }}</h2>
<div style="border-top:1px solid #C4CEDD">{% for it in text.contact.s3.list %}<details class="faq"><summary>{{ it.question }}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class=chev><path d="M6 9l6 6 6-6"/></svg></summary><p class="faq-a">{{ it.answer | rich({a: {'class': 'link-u', 'style': 'color:#1F3158; font-weight:500' } }) | safe }}</p></details>{% endfor %}</div>
</div></div></section>
</main>
