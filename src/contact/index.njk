<div style="display:flex; flex-direction:column; gap:8px; min-width:0"><label for="c-last" style="font-size:15px; font-weight:500; color:#333333">Last name <span aria-hidden="true">*</span></label><div class="field" style="display:flex; align-items:center; padding:0 16px; min-height:54px"><input id="c-last" name="last" type="text" placeholder="" value="" autocomplete="family-name" required style="flex:1; min-width:0; min-height:48px; border:0; outline:none; background:transparent; font-family:Montserrat,system-ui,sans-serif; font-size:16px; font-weight:500; color:#333333"></div></div>
</div>
