<a class="nav-a" href="/ways-to-help/"{% if current == "help" %} aria-current="page"{% endif %}>Ways to help</a>
<a class="nav-a" href="/about/"{% if current == "about" %} aria-current="page"{% endif %}>About us</a>
<a class="nav-a" href="/contact/"{% if current == "contact" %} aria-current="page"{% endif %}>Contact</a>
</nav>
<a class="btn btn-donate btn-sm" href="/donate/" style="margin-left:8px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>Donate</a>
<button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-button><span data-icon="open" style="display:flex"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"/></svg></span><span data-icon="close" style="display:none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg></span></button>
</div>
</div>
