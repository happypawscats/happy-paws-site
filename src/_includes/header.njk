<div role="region" aria-label="Appeal and charity details">
{% if appeal %}
<div class="on-dark" style="background:#1F3158; color:#E8EEF7">
<div class="wrap" style="padding-top:8px; padding-bottom:8px; display:flex; flex-wrap:wrap; align-items:center; gap:0 20px; font-size:14px; line-height:1.5">
<span><strong style="font-weight:700">Our rescue is in crisis.</strong> We're low on funds and urgently need your help to keep going.</span>
<a href="/donate/" style="font-weight:500; color:#ffffff; text-decoration:underline; text-underline-offset:4px; display:inline-flex; align-items:center; gap:6px; min-height:44px">Donate now<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
</div>
</div>
{% endif %}
<div class="hdr-strip">Registered charity no. 1220228</div>
</div>
<header style="position:sticky; top:0; z-index:40; background:#ffffff">
<div class="wrap" style="display:flex; align-items:center; justify-content:space-between; gap:12px; padding-top:10px; padding-bottom:10px">
<div class="hdr-brand"><a href="/" aria-label="Happy Paws Cat Rescue, home" style="display:block; line-height:0">
<img class="logo" width="260" height="154" src="/images/logo.png" alt="Happy Paws Cat Rescue">
</a><span class="hdr-charity">Registered charity<br>no. 1220228</span></div>
<div style="display:flex; align-items:center; gap:8px">
<nav aria-label="Main" class="nav-links" style="display:flex; align-items:center; gap:4px">
