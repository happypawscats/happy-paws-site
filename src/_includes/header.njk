<a class="menu-a" href="/cats/"{% if current == "adopt" %} aria-current="page"{% endif %}>Adopt a cat<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC1264" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg></a>
<a class="menu-a" href="/ways-to-help/"{% if current == "help" %} aria-current="page"{% endif %}>Ways to help<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC1264" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg></a>
<a class="menu-a" href="/about/"{% if current == "about" %} aria-current="page"{% endif %}>About us<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC1264" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg></a>
<a class="menu-a" href="/contact/"{% if current == "contact" %} aria-current="page"{% endif %}>Contact<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC1264" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg></a>
</div>
