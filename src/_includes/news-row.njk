<a class="news-row" href="{{ n.url }}"><span class="news-date">{{ n.data.date_text }}</span><div><h3 class="news-t">{{ n.data.title }}</h3><p style="margin:0; font-size:16px; line-height:1.65; max-width:560px">{{ n.data.summary }}</p></div><figure class="ph " style="aspect-ratio:4/3; background:#E4C9BF; "><img loading="lazy" decoding="async" src="{{ n.data.image }}" alt="{{ n.data.image_alt }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:50% 50%; display:block"></figure></a>
