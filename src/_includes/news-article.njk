---
layout: base.njk
---
<main id="main">
<!-- Article header -->
<section aria-labelledby="art-h" style="background:#ffffff">
<div class="wrap" style="padding-top:14px; padding-bottom:0">
<a class="link" href="/news/" style="margin-left:-2px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M19 12H5M11 6l-6 6 6 6"/></svg>{{ text.news_article.back }}</a>
</div>
<div class="wrap" style="padding-top:36px; padding-bottom:48px">
<div style="max-width:980px; display:flex; flex-direction:column; gap:24px">
<h1 id="art-h" class="display" style="color:#1F3158; font-size:clamp(38px,5.2vw,76px)">{{ title }}</h1>
<p style="margin:0; font-size:16px; color:#4F596B">{{ date_text }}{% if author %} · {{ author }}{% endif %}</p>
</div>
</div>
{% if image %}<div class="wrap">
<figure class="ph " style="aspect-ratio:16/7; background:#E4C9BF; "><img fetchpriority="high" decoding="async" src="{{ image }}" alt="{{ image_alt }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:50% 40%; display:block"></figure>
</div>{% endif %}
</section>

<section class="sec" style="background:#ffffff; padding-top:56px; padding-bottom:88px"><div class="wrap"><div class="art">
{{ content | safe }}
<div style="display:flex; flex-wrap:wrap; gap:8px 28px; align-items:center; border-top:1px solid #C4CEDD; padding-top:20px; margin-top:48px">
<span style="font-size:15px; color:#4F596B">{{ text.news_article.share }}</span>
<a class="link" href="https://www.facebook.com/sharer/sharer.php?u={{ (site.url + page.url) | urlencode }}" style="min-height:44px" target="_blank" rel="noopener">{{ text.news_article.facebook }}</a>
<a class="link" href="#" style="min-height:44px" data-copy-link>{{ text.news_article.copy }}</a>
</div>
</div></div></section>

{% set more = collections.newsLatest | otherNews(page.url, 3) %}
{% if more.length %}
<section aria-labelledby="more-h" class="sec" style="background:#ffffff; padding-top:0"><div class="wrap"><div style="display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:20px 48px; margin-bottom:40px">
<h2 id="more-h" class="h2" style="color:#ED217C">{{ text.news_article.more }}</h2>
<a class="link" href="/news/">{{ text.news_article.all }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
</div>
<div style="border-top:1px solid #C4CEDD">{% for n in more %}{% include "news-row.njk" %}{% endfor %}</div></div></section>
{% endif %}

{% include "newsletter.njk" %}
</main>
