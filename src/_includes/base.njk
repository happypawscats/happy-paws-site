<!doctype html>
<html lang="en-GB" data-give-links="{{ site.donate.links | dump }}" data-form-endpoint="{{ site.forms.endpoint }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page.url == '/' %}{{ site.name }}: {{ title | lower }}{% else %}{{ title }} | {{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url if page.url != '/404.html' else '/' }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/images/cat-grey.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#1F3158">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/montserrat-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css">
{%- for c in css %}
<link rel="stylesheet" href="/assets/css/{{ c }}.css">
{%- endfor %}
</head>
<body>
<div id="top" style="width:100%; overflow-x:clip; background:#ffffff">
<a class="skip" href="#main">Skip to main content</a>
{% include "header.njk" %}
{{ content | safe }}
{% include "footer.njk" %}
</div>
<script src="/assets/js/site.js" defer></script>
{%- for j in js %}
<script src="/assets/js/{{ j }}.js" defer></script>
{%- endfor %}
</body>
</html>
