<section aria-labelledby="news-h" class="sec" style="background:#E8EEF7; padding-top:80px; padding-bottom:80px">
<div class="wrap">
<div class="two-grid" style="align-items:center">
<div>
<h2 id="news-h" style="font-size:clamp(28px,3vw,40px); line-height:1.1; letter-spacing:-0.02em; color:#1F3158; margin-bottom:14px">{{ text.newsletter.h2 | rich | safe }}</h2>
<p style="margin:0; font-size:17px; line-height:1.65; max-width:460px">{{ text.newsletter.p }}</p>
</div>
<form method="post" name="newsletter" data-form="newsletter" data-netlify="true" data-netlify-honeypot="bot-field" style="display:flex; flex-direction:column; gap:12px; max-width:560px"><input type="hidden" name="form-name" value="newsletter"><p hidden><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
<label for="news-email" style="font-size:15px; font-weight:500">{{ text.newsletter.label }}</label>
<div class="stack-sm" style="display:flex; gap:12px">
<div class="field" style="flex:1; min-width:0; display:flex; align-items:center; padding:0 18px; min-height:56px">
<input id="news-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" style="flex:1; min-width:0; min-height:48px; border:0; outline:none; background:transparent; font-family:Montserrat,system-ui,sans-serif; font-size:17px; font-weight:500; color:#333333">
</div>
<button class="btn btn-primary" type="submit" style="min-height:56px">{{ text.newsletter.button }}</button>
</div>
<p style="margin:0; font-size:13px; line-height:1.5; color:#4F596B">{{ text.newsletter.p2 }}</p>
</form>
</div>
</div>
</section>
