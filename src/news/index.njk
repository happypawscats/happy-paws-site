---
layout: base.njk
permalink: "/news/"
current: "about"
appeal: true
css: ["pages/news"]
js: []
eleventyComputed:
  title: "{{ text.news.meta.title }}"
  description: "{{ text.news.meta.description }}"
---
<main id="main">
<!-- Intro -->
<section aria-labelledby="pg-h" style="background:#E8EEF7">
<div class="wrap" style="padding-top:72px; padding-bottom:72px">
<div class="head-grid">
<h1 id="pg-h" class="display" style="color:#1F3158">{{ text.news.s1.h1 | rich({hl: 'color:#ED217C' }) | safe }}</h1>
<div style="display:flex; flex-direction:column; gap:14px; max-width:460px"><p class="lede" style="">{{ text.news.s1.p }}</p><div><a class="link" href="{{ site.social.facebook or "#" }}"{% if not site.social.facebook %} data-placeholder="link to add"{% else %} target="_blank" rel="noopener"{% endif %}>{{ text.news.s1.link }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></div>
</div>
</div>
</section>

{% set lead = collections.newsLatest[0] %}
{% if lead %}
<section class="sec" style="background:#ffffff; padding-bottom:56px"><div class="wrap"><a class="lead" href="{{ lead.url }}" style="text-decoration:none; color:#333333">
<figure class="ph " style="aspect-ratio:4/3; background:#E4C9BF; "><img fetchpriority="high" decoding="async" src="{{ lead.data.image }}" alt="{{ lead.data.image_alt }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:50% 42%; display:block"></figure>
<div style="display:flex; flex-direction:column; gap:18px; align-items:flex-start">
<p style="margin:0; font-size:15px; color:#4F596B">{{ text.news.s2.latest }} · {{ lead.data.date_text }}</p>
<h2 class="h2" style="color:#1F3158; font-size:clamp(30px,3.6vw,50px)">{{ lead.data.title }}</h2>
<p style="margin:0; font-size:17px; line-height:1.7; max-width:520px">{{ lead.data.summary }}</p>
<span class="link" style="margin-top:4px">{{ text.news.s2.text }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
</div>
</a></div></section>
{% endif %}

{% if collections.newsLatest.length > 1 %}
<section aria-labelledby="all-h" class="sec" style="background:#ffffff; padding-top:24px"><div class="wrap"><h2 id="all-h" class="h2" style="color:#ED217C; margin-bottom:40px">{{ text.news.s3.h2 }}</h2>
<div style="border-top:1px solid #C4CEDD">{% for n in collections.newsLatest %}{% if not loop.first %}{% include "news-row.njk" %}{% endif %}{% endfor %}</div></div></section>
{% endif %}

{% if text.news.s4.list | length %}<section aria-labelledby="ev-h" class="sec on-dark" style="background:#1F3158; color:#E8EEF7; "><div class="wrap"><div class="two-grid">
<div style="display:flex; flex-direction:column; gap:24px; align-items:flex-start">
<h2 id="ev-h" class="h2" style="color:#ffffff">{{ text.news.s4.h2 | rich | safe }}</h2>
<p style="margin:0; font-size:17px; line-height:1.7; max-width:400px">{{ text.news.s4.p }}</p>
</div>
<div style="border-top:1px solid rgba(232,238,247,.4)">{% for it in text.news.s4.list %}<div class="ev-row"><span style="font-size:16px; color:#C7D2E6">{{ it.text }}</span><span style="font-size:20px; line-height:1.35; font-weight:500; color:#ffffff">{{ it.text2 }}</span><span style="font-size:16px; color:#E8EEF7">{{ it.text3 }}</span></div>{% endfor %}</div>
</div></div></section>{% endif %}

<!-- Newsletter -->
{% include "newsletter.njk" %}
</main>
