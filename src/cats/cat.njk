---
layout: base.njk
pagination:
  data: cats
  size: 1
  alias: cat
  addAllPagesToCollections: true
permalink: "/cats/{{ cat.slug }}/"
eleventyComputed:
  title: "{{ cat.name }}, {{ 'an' if cat.age_band == 'Adult' else 'a' }} {{ cat.age_band | lower }} looking for a home"
  description: "Meet {{ cat.name }}, {{ 'an' if cat.age_band == 'Adult' else 'a' }} {{ cat.age_band | lower }} looking for a home{% if cat.area %} in {{ cat.area }}{% endif %}. Read their story and apply to adopt."
current: "adopt"
appeal: true
css: ["pages/cat"]
js: []
---
<main id="main">
<!-- Cat hero -->
<section aria-labelledby="cat-h" style="background:#ffffff">
<div class="wrap" style="padding-top:14px; padding-bottom:6px">
<a class="link" href="/cats/" style="margin-left:-2px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M19 12H5M11 6l-6 6 6 6"/></svg>{{ text.cat_page.s1.link }}</a>
</div>
<div class="prof-grid">
<div class="prof-photo-cell">
<figure class="ph prof-photo" style="height:100%; background:{{ cat.bg }}; position:absolute; inset:0"><img src="/images/{{ cat.photos[0].src }}" alt="{{ cat.photos[0].alt }}" fetchpriority="high" decoding="async" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:{{ cat.photos[0].pos }}; display:block"></figure>
</div>
<div class="prof-info pad-r">
<h1 id="cat-h" class="display" style="color:#1F3158; font-size:clamp(48px,6.4vw,96px)">{{ cat.name }}</h1>
<p class="lede" style="max-width:520px; font-size:20px">{{ cat.tagline }}</p>
<dl class="dl-rules" style="max-width:600px">
<div class="fact"><dt>{{ text.cat_page.s1.dt }}</dt><dd>{{ cat.age_text }}</dd></div>
<div class="fact"><dt>{{ text.cat_page.s1.dt2 }}</dt><dd>{{ cat.sex }}</dd></div>
<div class="fact"><dt>{{ text.cat_page.s1.dt3 }}</dt><dd>{{ cat.colour }}</dd></div>
{% if cat.area %}<div class="fact"><dt>{{ text.cat_page.s1.dt4 }}</dt><dd>{{ cat.area }}</dd></div>{% endif %}
<div class="fact"><dt>{{ text.cat_page.s1.dt5 }}</dt><dd>{{ cat.good_with }}</dd></div>
<div class="fact"><dt>{{ text.cat_page.s1.dt6 }}</dt><dd>{{ cat.health }}</dd></div>
<div class="fact"><dt>{{ text.cat_page.s1.dt7 }}</dt><dd>{{ cat.donation }}</dd></div>
</dl>
<div style="display:flex; flex-direction:column; gap:16px; align-items:flex-start">
<a class="btn btn-primary" href="/apply/?cat={{ cat.name | urlencode }}">{{ text.cat_page.s1.btn | rich | fill({name: cat.name }) | safe }}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
<p style="margin:0; font-size:15px; line-height:1.6; color:#4F596B; max-width:460px">{{ text.cat_page.s1.p | rich({a: {'class': 'link-u', 'style': 'color:#1F3158; font-weight:500' } }) | safe }}</p>
</div>
</div>
</div>
</section>

<!-- Story -->
<section aria-labelledby="story-h" class="sec" style="background:#ffffff; padding-top:96px; padding-bottom:104px">
<div class="wrap">
<div class="two-grid" style="margin-bottom:64px">
<h2 id="story-h" class="h2" style="color:#ED217C">{{ text.cat_page.s2.h2 | rich | fill({name: cat.name }) | safe }}</h2>
<div style="display:flex; flex-direction:column; gap:20px; max-width:620px">
{% for p in cat.story %}<p style="margin:0; font-size:{{ '19px' if loop.first else '17px' }}; line-height:{{ '1.7' if loop.first else '1.75' }}">{{ p }}</p>
{% endfor %}</div>
</div>
<div class="gal">
{% set g1 = cat.photos[1] or cat.photos[0] %}{% set g2 = cat.photos[2] or cat.photos[1] or cat.photos[0] %}
<figure class="ph " style="aspect-ratio:3/2; background:{{ cat.bg }}; "><img src="/images/{{ g1.src }}" alt="{{ g1.alt }}" loading="lazy" decoding="async" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:{{ g1.pos if cat.photos[1] else '50% 22%' }}; display:block"></figure>
<figure class="ph " style="aspect-ratio:4/5; background:{{ cat.bg }}; "><img src="/images/{{ g2.src }}" alt="{{ g2.alt }}" loading="lazy" decoding="async" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:{{ g2.pos if (cat.photos[2] or cat.photos[1]) else '50% 100%' }}; display:block"></figure>
</div>
</div>
</section>

<!-- Apply for this cat -->
<section id="ask" aria-labelledby="ask-h" class="sec on-dark" style="background:#1F3158; color:#E8EEF7; scroll-margin-top:72px">
<div class="wrap">
<div class="two-f">
<div style="display:flex; flex-direction:column; gap:28px">
<h2 id="ask-h" class="h2" style="color:#ffffff">{{ text.cat_page.s3.h2 | rich | fill({name: cat.name }) | safe }}</h2>
<p style="margin:0; font-size:18px; line-height:1.7; max-width:440px">{{ text.cat_page.s3.p }}</p>
<div style="display:flex; flex-direction:column; gap:16px; align-items:flex-start">
<a class="btn btn-light" href="/apply/?cat={{ cat.name | urlencode }}" style="min-height:56px">{{ text.cat_page.s3.btn | rich | fill({name: cat.name }) | safe }}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
<p style="margin:0; font-size:15px; line-height:1.6; color:#C7D2E6; max-width:440px">{{ text.cat_page.s3.p2 | rich({a: {'style': 'color:#ffffff; font-weight:500; text-decoration:underline; text-underline-offset:3px' } }) | safe }}</p>
</div>
</div>
<div style="max-width:440px">
<div class="estep"><span class="estep-n">1</span><span style="font-size:16px; line-height:1.6">{{ text.cat_page.s3.text }}</span></div>
<div class="estep"><span class="estep-n">2</span><span style="font-size:16px; line-height:1.6">{{ text.cat_page.s3.text2 }}</span></div>
<div class="estep" style="border-bottom:1px solid rgba(232,238,247,.4)"><span class="estep-n">3</span><span style="font-size:16px; line-height:1.6">{{ text.cat_page.s3.text3 | rich | fill({name: cat.name }) | safe }}</span></div>
</div>
</div>
</div>
</section>

<!-- More cats -->
<section aria-labelledby="more-h" class="sec" style="background:#ffffff; padding-top:96px; padding-bottom:104px">
<div class="wrap">
<div style="display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:20px 48px; margin-bottom:56px">
<h2 id="more-h" class="h2" style="color:#ED217C">{{ text.cat_page.s4.h2 | rich | safe }}</h2>
<a class="link" href="/cats/">{{ text.cat_page.s4.link }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
</div>
<div class="cat-grid">
{% for c in cats | othersThan(cat.slug, 3) %}
<a class="cat " href="/cats/{{ c.slug }}/" style="display:block; text-decoration:none; color:#333333"><figure class="ph cat-img" style="background:{{ c.bg }}; "><img src="/images/{{ c.photos[0].src }}" alt="{{ c.photos[0].alt }}" loading="lazy" decoding="async" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:{{ c.photos[0].pos }}; display:block"></figure><div class="cat-row"><span class="cat-name">{{ c.name }}</span><span class="cat-meta">{{ c.age_band }}{% if c.area %} · {{ c.area }}{% endif %}</span></div></a>
{% endfor %}
</div>
</div>
</section>
</main>
