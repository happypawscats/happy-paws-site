---
layout: base.njk
permalink: "/ways-to-help/"
current: "help"
appeal: true
css: []
js: []
eleventyComputed:
  title: "{{ text.ways_to_help.meta.title }}"
  description: "{{ text.ways_to_help.meta.description }}"
---
<main id="main">
<!-- Hero -->
<section aria-labelledby="pg-h" class="ih">
<div class="ih-copy pad-l">
<h1 id="pg-h" class="display" style="color:#1F3158">{{ text.ways_to_help.s1.h1 | rich({hl: 'color:#ED217C' }) | safe }}</h1>
<div style="display:flex; flex-direction:column; gap:14px; max-width:520px"><p class="lede" style="">{{ text.ways_to_help.s1.p }}</p><p style="margin:0; font-size:17px; line-height:1.7; color:#333333; ">{{ text.ways_to_help.s1.p2 }}</p></div>
<div class="stack-sm" style="display:flex; flex-wrap:wrap; gap:12px"><a class="btn btn-donate" href="/donate/" >{{ text.ways_to_help.s1.btn }}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a><a class="btn btn-outline" href="/foster/" >{{ text.ways_to_help.s1.btn2 }}</a></div>
</div>
<div class="ih-photo"><figure class="ph " style="height:100%; background:#E4C9BF; position:absolute; inset:0"><img fetchpriority="high" decoding="async" src="{{ text.ways_to_help.s1.img }}" alt="{{ text.ways_to_help.s1.alt }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:50% 38%; display:block"></figure></div>
</section>

<section aria-labelledby="ways-h" class="sec" style="background:#ffffff; "><div class="wrap"><h2 id="ways-h" class="h2" style="color:#ED217C; margin-bottom:56px">{{ text.ways_to_help.s2.h2 | rich | safe }}</h2>
<div class="rules"><div class="rule-row"><h3>{{ text.ways_to_help.s2.h3 }}</h3><p>{{ text.ways_to_help.s2.p }}</p><div class="act"><a class="btn btn-donate btn-sm" href="/donate/" >{{ text.ways_to_help.s2.btn }}</a></div></div><div class="rule-row"><h3>{{ text.ways_to_help.s2.h32 }}</h3><p>{{ text.ways_to_help.s2.p2 }}</p><div class="act"><a class="link" href="/foster/">{{ text.ways_to_help.s2.link }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></div><div class="rule-row"><h3>{{ text.ways_to_help.s2.h33 }}</h3><p>{{ text.ways_to_help.s2.p3 }}</p><div class="act"><a class="link" href="/contact/">{{ text.ways_to_help.s2.link2 }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></div><div class="rule-row"><h3>{{ text.ways_to_help.s2.h34 }}</h3><p>{{ text.ways_to_help.s2.p4 }}</p><div class="act"><a class="link" href="{{ site.wishlist or "#" }}"{% if not site.wishlist %} data-placeholder="link to add"{% else %} target="_blank" rel="noopener"{% endif %}>{{ text.ways_to_help.s2.link3 }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></div></div></div></div></section>

<section aria-labelledby="stat-h" class="sec on-dark" style="background:#1F3158; color:#E8EEF7; "><div class="wrap"><div class="two-grid" style="align-items:center">
<p aria-hidden="true" style="margin:0; font-size:clamp(72px,11vw,164px); line-height:.9; letter-spacing:-0.05em; font-weight:500; color:#F5CDD6">£200</p>
<div style="display:flex; flex-direction:column; gap:26px; align-items:flex-start; max-width:560px">
<h2 id="stat-h" class="h2" style="color:#ffffff; font-size:clamp(28px,3.3vw,46px)">{{ text.ways_to_help.s3.h2 | rich({hl: 'position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap' }) | safe }}</h2>
<p style="margin:0; font-size:18px; line-height:1.7">{{ text.ways_to_help.s3.p }}</p>
<a class="btn btn-light" href="/donate/" >{{ text.ways_to_help.s3.btn }}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
</div>
</div></div></section>

<!-- Newsletter -->
{% include "newsletter.njk" %}
</main>
