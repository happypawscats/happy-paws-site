---
layout: base.njk
permalink: "/enquiry-sent/"
current: "contact"
appeal: true
css: ["pages/enquiry-sent"]
js: []
noindex: true
eleventyComputed:
  title: "{{ text.enquiry_sent.meta.title }}"
  description: "{{ text.enquiry_sent.meta.description }}"
---
<main id="main">
<!-- Hero -->
<section aria-labelledby="pg-h" class="ih">
<div class="ih-copy pad-l">
<h1 id="pg-h" class="display" style="color:#1F3158">{{ text.enquiry_sent.s1.h1 | rich({hl: 'color:#ED217C' }) | safe }}</h1>
<div style="display:flex; flex-direction:column; gap:14px; max-width:520px"><p class="lede" style="">{{ text.enquiry_sent.s1.p }}</p><p style="margin:0; font-size:17px; line-height:1.7; color:#333333; ">{{ text.enquiry_sent.s1.p2 }}</p></div>

</div>
<div class="ih-photo"><figure class="ph " style="height:100%; background:#E4C9BF; position:absolute; inset:0"><img fetchpriority="high" decoding="async" src="{{ text.enquiry_sent.s1.img }}" alt="{{ text.enquiry_sent.s1.alt }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:22% 50%; display:block"></figure></div>
</section>

<section aria-labelledby="next-h" class="sec" style="background:#ffffff; "><div class="wrap"><h2 id="next-h" class="h2" style="color:#ED217C; margin-bottom:48px">{{ text.enquiry_sent.s2.h2 | rich | safe }}</h2>
<ol style="list-style:none; margin:0; padding:0; border-top:1px solid #C4CEDD">{% for it in text.enquiry_sent.s2.list %}<li class="as-row" style="list-style:none"><span class="as-n">{{ loop.index }}</span><h3>{{ it.h3 }}</h3><div><p>{{ it.p }}</p></div></li>{% endfor %}</ol></div></section>

<section aria-labelledby="wait-h" class="sec" style="background:#E8EEF7; "><div class="wrap"><div class="two-grid">
<h2 id="wait-h" class="h2" style="color:#ED217C">{{ text.enquiry_sent.s3.h2 | rich | safe }}</h2>
<div style="border-top:1px solid #C4CEDD; max-width:680px">
<a class="go-row" href="/cats/">{{ text.enquiry_sent.s3.link }}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
<a class="go-row" href="/adopting/">{{ text.enquiry_sent.s3.link2 }}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
<a class="go-row" href="{{ site.social.facebook or "#" }}"{% if not site.social.facebook %} data-placeholder="link to add"{% else %} target="_blank" rel="noopener"{% endif %}>{{ text.enquiry_sent.s3.link3 }}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" ><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
</div>
</div></div></section>
</main>
