<div style="display:flex; flex-direction:column; gap:14px; max-width:460px"><p class="lede" style="">{{ text.foster_apply.s1.p }}</p><p style="margin:0; font-size:15px; line-height:1.7; color:#4F596B; ">{{ text.foster_apply.s1.p2 | rich({a: {'class': 'link-u', 'style': 'color:#1F3158; font-weight:500' } }) | safe }}</p></div>
</div>
</div>
</section>

{% set ap_form = site.applications.foster %}
{% set ap_title = "Foster application form" %}
